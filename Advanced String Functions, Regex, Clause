1327. List the Products Ordered in a Period
SELECT product_name, SUM(unit) AS unit
FROM Products INNER JOIN Orders USING (product_id)
WHERE MONTH(order_date) = 2 AND YEAR(order_date) = 2020
GROUP BY product_name
HAVING unit >= 100;

